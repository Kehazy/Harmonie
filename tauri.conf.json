{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harmonie",
  "version": "3.0.0",
  "identifier": "app.harmonie.spicetify",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Harmonie",
        "width": 980,
        "height": 640,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
